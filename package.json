{
  "name": "creative-web-architect",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source autonomous AI creative-development system for generating exceptional websites from minimal descriptions.",
  "author": "Creative Web Architect Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/creative-web-architect/creative-web-architect.git"
  },
  "keywords": [
    "ai",
    "web-design",
    "creative-agent",
    "liquid-glass",
    "motion-design",
    "3d-web",
    "design-system",
    "agent-skills"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint packages/ --ext .ts,.tsx",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "doctor": "node packages/cli/dist/index.js doctor",
    "cwa": "node packages/cli/dist/index.js",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
